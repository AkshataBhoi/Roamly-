{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/index.ts"
    },
    "ml": {
      "root": "ml",
      "entrypoint": "app.py"
    }
  },
  "functions": {
    "backend/src/index.ts": {
      "includeFiles": "backend/node_modules/**"
    }
  },
  "rewrites": [
    {
      "source": "/ml/(.*)",
      "destination": {
        "type": "service",
        "service": "ml"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}